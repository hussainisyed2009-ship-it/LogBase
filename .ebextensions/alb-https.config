option_settings:
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5
    HealthCheckInterval: 15
    HealthCheckTimeout: 5
    Port: 80
    Protocol: HTTP
    DeregistrationDelay: 20
    
  # IMPORTANT: Replace CERTIFICATE_ARN with your ACM certificate ARN
  # Format: arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012
  aws:elasticbeanstalk:environment:process:https:
    HealthCheckPath: /
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5
    HealthCheckInterval: 15
    HealthCheckTimeout: 5
    Port: 443
    Protocol: HTTPS
    SSLCertificateArns: arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012
    DeregistrationDelay: 20
    InstancePort: 80
    InstanceProtocol: HTTP
